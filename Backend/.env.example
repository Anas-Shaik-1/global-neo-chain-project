PORT=3000
MONGO_URI=mongodb://localhost:27017/ems
FRONTEND_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=development-access-secret-change-me-please-32chars
JWT_REFRESH_SECRET=development-refresh-secret-change-me-please-32chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
SEED_ADMIN_EMAIL=admin@global-neochain.local
SEED_ADMIN_PASSWORD=ChangeMe-Admin-1!
NODE_ENV=development
LOG_LEVEL=debug

# File storage
# STORAGE_DRIVER picks the file backend.
#   local      → write under UPLOADS_DIR (good for dev, demo, single-host).
#   cloudinary → upload via the Cloudinary SDK; assets served from their CDN
#                with on-the-fly transforms (avatar variants, image
#                compression). Required for any prod deployment that wants
#                persistent media + responsive images.
STORAGE_DRIVER=local

# UPLOADS_DIR is the on-disk root for user-uploaded files (avatars, resumes,
# chat attachments, expense receipts). Only used when STORAGE_DRIVER=local.
# Mount a persistent volume at this path in production.
UPLOADS_DIR=./uploads
# PUBLIC_BASE_URL is the externally reachable origin used to build file URLs
# in API responses. Behind a reverse proxy / CDN this is the public origin.
PUBLIC_BASE_URL=http://localhost:3000

# Cloudinary (only required when STORAGE_DRIVER=cloudinary)
# Find these in Cloudinary Console → Dashboard → API keys.
# All three are required together; the server fails fast at boot if any is
# missing while STORAGE_DRIVER=cloudinary.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Email
# MAIL_DRIVER=console logs delivery to stdout (dev only). NODE_ENV=production
# refuses to start with MAIL_DRIVER=console. Choose one of: console | smtp | resend.
MAIL_DRIVER=console
MAIL_FROM=noreply@example.com
# SMTP (when MAIL_DRIVER=smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Resend (when MAIL_DRIVER=resend)
# RESEND_API_KEY=

# Contact form
# Where the public /contact form's notification emails are routed.
# Defaults to MAIL_FROM if unset. Use a shared inbox you actually monitor.
# CONTACT_INBOX_TO=hello@global-neochain.com

# Zoho OAuth (sign in + sign up via Zoho Accounts)
# Register an OAuth client at https://api-console.zoho.com → Server-based
# Application. Set the homepage to FRONTEND_ORIGIN and the authorized
# redirect URI to ZOHO_REDIRECT_URI (must match exactly, including scheme +
# port). Leave the three values blank to disable the feature; the FE will
# hide the "Continue with Zoho" button and the routes will 404.
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REDIRECT_URI=http://localhost:3000/auth/zoho/callback
# Override for non-`.com` Zoho regions (.in, .eu, .com.au, .jp). Match the
# region of the Zoho account that owns your OAuth client.
# ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com

# Office geofence (attendance clock-in).
# When BOTH latitude and longitude are set, non-remote clock-ins must
# happen within OFFICE_GEOFENCE_RADIUS_M metres of this point. Leaving
# either coordinate unset disables the geofence (clock-in succeeds
# without location). Remote clock-ins (isRemote=true) always bypass.
# OFFICE_LATITUDE=17.4485
# OFFICE_LONGITUDE=78.3908
OFFICE_GEOFENCE_RADIUS_M=200
